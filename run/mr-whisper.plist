<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent do macOS. Copie para ~/Library/LaunchAgents/com.mriago.mr-whisper.plist,
     ajuste o caminho do daemon.py abaixo, e rode:
       launchctl load ~/Library/LaunchAgents/com.mriago.mr-whisper.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mriago.mr-whisper</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/ABSOLUTE/PATH/TO/mr-whisper/daemon.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
</dict>
</plist>
